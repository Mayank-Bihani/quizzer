{
  "name": "quizzer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --config web/vite.config.ts",
    "check:viewports": "node web/scripts/check-viewports.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --project web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:web": "vitest run --config web/vitest.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply quizzer-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply quizzer-db --remote",
    "db:seed:local": "wrangler d1 execute quizzer-db --local --file=migrations/seed.sql",
    "db:seed:remote": "wrangler d1 execute quizzer-db --remote --file=migrations/seed.sql"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "hono": "^4.6.0",
    "jose": "^6.2.12",
    "katex": "^0.16.22",
    "papaparse": "^5.7.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260908.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.0",
    "vite": "^7.1.5",
    "vitest": "^4.1.0",
    "wrangler": "^4.130.0"
  }
}
